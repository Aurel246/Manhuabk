# Manhuabk — variables d'environnement
# Copier vers .env et remplir. NE JAMAIS committer .env.

# --- Base de données ---
# PostgreSQL (Neon, Supabase, ou local). Format :
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/manhuabk?sslmode=disable"

# --- Auth.js ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
# URL publique de l'app (prod : https://manhuabk.example)
NEXTAUTH_URL="http://localhost:3000"

# --- Stockage objet (S3 / Cloudflare R2) ---
# Laisser vide pour utiliser le stockage local (dev).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL publique du CDN servant les images (ex: https://cdn.manhuabk.example)
CDN_URL=""

# --- App ---
# "development" | "production" | "test"
NODE_ENV="development"
# URL publique du site (prod : https://manhuabk.example) — pour SEO/canonical/sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
